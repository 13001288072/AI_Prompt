<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F5FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 页面标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="创建你的专属提示词 ✨"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#2D2350"
            android:layout_marginTop="48dp" />

        <!-- 页面副标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="填写需求，定制 AI 的回答方式"
            android:textSize="15sp"
            android:textColor="#777088"
            android:layout_marginTop="12dp" />


        <!-- 作者信息：固定显示，不可编辑 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="姓名：范方忆    学号：2406100106"
            android:textSize="13sp"
            android:textColor="#777088"
            android:layout_marginTop="16dp" />


        <!-- 需求输入区域 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="你想让 AI 帮你做什么？"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#2D2350"
            android:layout_marginTop="36dp" />

        <EditText
            android:id="@+id/etQuestion"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="例如：帮我理解冒泡排序……"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:padding="16dp"
            android:textSize="15sp"
            android:backgroundTint="#6750A4"
            android:layout_marginTop="12dp" />

        <!-- 任务类型 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择任务类型"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#2D2350"
            android:layout_marginTop="28dp" />

        <Spinner
            android:id="@+id/spTaskType"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:padding="8dp" />

        <!-- 回答风格 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择回答风格"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#2D2350"
            android:layout_marginTop="28dp" />

        <RadioGroup
            android:id="@+id/rgStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:checkedButton="@id/rbDetailed">

            <RadioButton
                android:id="@+id/rbDetailed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="详细讲解"
                android:textSize="15sp"
                android:buttonTint="#6750A4" />

            <RadioButton
                android:id="@+id/rbConcise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="简洁回答"
                android:textSize="15sp"
                android:buttonTint="#6750A4" />

            <RadioButton
                android:id="@+id/rbProfessional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="专业正式"
                android:textSize="15sp"
                android:buttonTint="#6750A4" />

        </RadioGroup>

        <!-- 附加要求 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="附加要求（可多选）"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#2D2350"
            android:layout_marginTop="28dp" />

        <CheckBox
            android:id="@+id/cbExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="举例说明"
            android:textSize="15sp"
            android:buttonTint="#6750A4"
            android:layout_marginTop="8dp" />

        <CheckBox
            android:id="@+id/cbSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="分步骤回答"
            android:textSize="15sp"
            android:buttonTint="#6750A4" />

        <CheckBox
            android:id="@+id/cbTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="使用表格整理"
            android:textSize="15sp"
            android:buttonTint="#6750A4" />

        <!-- 生成按钮 -->
        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✨ 生成提示词"
            android:textSize="17sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6750A4"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>

</ScrollView>
